    <PackageVersion Include="FSharp.Core" Version="11.0.100" />
    <PackageVersion Include="Hangfire" Version="1.8.25" />
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.Mongo" Version="1.16.3" />
    <PackageVersion Include="KubernetesClient" Version="19.0.2" />
