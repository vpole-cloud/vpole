root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,fs,csproj,fsproj,props,targets}]
indent_style = space
indent_size = 4

[*.cs]
max_line_length = 120
csharp_new_line_before_open_brace = all
resharper_csharp_keep_existing_embedded_arrangement = false
resharper_csharp_keep_existing_embedded_block_arrangement = false
resharper_csharp_place_simple_embedded_statement_on_same_line = false
resharper_csharp_place_simple_embedded_block_on_same_line = false
resharper_csharp_wrap_arguments_style = chop_if_long
resharper_csharp_wrap_parameters_style = chop_if_long
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_comma = true
csharp_space_around_binary_operators = before_and_after
dotnet_sort_system_directives_first = true

[*.{json,yml,yaml,js,jsx,ts,tsx}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# This consumer owns a closed provisioning outcome; a new unhandled case must fail the build.
[src/features/Functions/Functions.Runtime/Consumers/FunctionRevisionCreatedConsumer.cs]
dotnet_diagnostic.CS8509.severity = error
