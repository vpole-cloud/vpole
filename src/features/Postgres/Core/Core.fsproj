<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>Pole.Features.Postgres</AssemblyName>
        <RootNamespace>Pole.Features.Postgres</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Common\PostgresSettings.fs" />
        <Compile Include="Common\PostgresClusterDto.fs" />
        <Compile Include="Common\MongoExtensions.fs" />
        <Compile Include="Common\ResultF.fs" />
        <Compile Include="Kubernetes\PostgresClusterKubernetesBuilder.fs" />
        <Compile Include="Kubernetes\PostgresStatefulSetKubernetesBuilder.fs" />
        <Compile Include="Kubernetes\PostgresClusterSecretStore.fs" />
        <Compile Include="Kubernetes\PostgresClusterKubernetesResourceManager.fs" />
        <Compile Include="Endpoints\Create.fs" />
        <Compile Include="Endpoints\Delete.fs" />
        <Compile Include="Endpoints\Update.fs" />
        <Compile Include="Endpoints\UpdatePassword.fs" />
        <Compile Include="Endpoints\GetConnectionString.fs" />
        <Compile Include="Endpoints\GetSupportedVersions.fs" />
        <Compile Include="Endpoints\GetById.fs" />
        <Compile Include="Endpoints\Get.fs" />
        <Compile Include="Endpoints\AllPostgresEndpoints.fs" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.1.1" />
        <PackageReference Include="KubernetesClient" Version="19.0.2" />
        <PackageReference Update="FSharp.Core" Version="10.1.203" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Events\Events.fsproj" />
      <ProjectReference Include="..\..\..\helpers\ASP\ASP.csproj" />
      <ProjectReference Include="..\..\..\shared\Database\Database.csproj" />
      <ProjectReference Include="..\..\..\domain\Models.FSharp\Core\Core.fsproj" />
      <ProjectReference Include="..\..\..\shared\Events\Events.csproj" />
      <ProjectReference Include="..\..\..\shared\Request\Request.csproj" />
      <ProjectReference Include="..\..\..\helpers\Mediator\Mediator.csproj" />
    </ItemGroup>
</Project>
