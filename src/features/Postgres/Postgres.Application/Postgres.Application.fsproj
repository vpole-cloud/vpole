<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>Pole.Features.Postgres.Application</AssemblyName>
        <RootNamespace>Pole.Features.Postgres.Application</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Common\PostgresSettings.fs" />
        <Compile Include="Common\PostgresQuotaProfile.fs" />
        <Compile Include="Common\PostgresClusterDto.fs" />
        <Compile Include="Common\ResourceDeploymentQueryExtensions.fs" />
        <Compile Include="Common\TypedResultInterop.fs" />
        <Compile Include="Common\PostgresResourceDeployment.fs" />
        <Compile Include="Common\PostgresClusterCredentials.fs" />
        <Compile Include="Common\PostgresClusterEventExtensions.fs" />
        <Compile Include="Search\PostgresSearchProjectionConsumers.fs" />
        <Compile Include="Persistence\PostgresOutcome.fs" />
        <Compile Include="Persistence\PostgresFilters.fs" />
        <Compile Include="Persistence\PostgresPersistenceGuards.fs" />
        <Compile Include="Persistence\Reads\LoadPostgresClusterById.fs" />
        <Compile Include="Persistence\Reads\LoadPostgresClusterPage.fs" />
        <Compile Include="Persistence\Credentials\PostgresCredentialErrors.fs" />
        <Compile Include="Persistence\Credentials\CreatePostgresCredential.fs" />
        <Compile Include="Persistence\Credentials\LoadPostgresCredential.fs" />
        <Compile Include="Persistence\Credentials\RotatePostgresCredential.fs" />
        <Compile Include="Persistence\Credentials\PersistRotatedPostgresCredential.fs" />
        <Compile Include="Persistence\Credentials\ResolvePostgresClusterCredentials.fs" />
        <Compile Include="Persistence\Mutations\PersistCreatedPostgresCluster.fs" />
        <Compile Include="Persistence\Mutations\PersistUpdatedPostgresCluster.fs" />
        <Compile Include="Persistence\Lifecycle\BeginPostgresClusterDeletion.fs" />
        <Compile Include="Persistence\Lifecycle\FinalizePostgresClusterDeletion.fs" />
        <Compile Include="Persistence\PostgresPersistenceRegistration.fs" />
        <Compile Include="Kubernetes\PostgresClusterKubernetesBuilder.fs" />
        <Compile Include="Kubernetes\PostgresStatefulSetKubernetesBuilder.fs" />
        <Compile Include="Kubernetes\PostgresClusterKubernetesResourceManager.fs" />
        <Compile Include="Kubernetes\PostgresResourceDeploymentAdapter.fs" />
        <Compile Include="Endpoints\CreatePostgresCluster.fs" />
        <Compile Include="Endpoints\DeletePostgresCluster.fs" />
        <Compile Include="Endpoints\UpdatePostgresCluster.fs" />
        <Compile Include="Endpoints\UpdatePostgresClusterPassword.fs" />
        <Compile Include="Endpoints\GetPostgresClusterConnectionString.fs" />
        <Compile Include="Endpoints\GetSupportedPostgresVersions.fs" />
        <Compile Include="Endpoints\GetPostgresClusterById.fs" />
        <Compile Include="Endpoints\GetPostgresClusters.fs" />
        <Compile Include="Endpoints\AllPostgresEndpoints.fs" />
        <Compile Include="Common\PostgresHttpMappings.fs" />
        <Compile Include="PostgresFeatureRegistration.fs" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <PropertyGroup>
        <WarningsAsErrors>$(WarningsAsErrors);FS0025</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="KubernetesClient" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\..\DeploymentTargets\DeploymentTargets.Contracts\DeploymentTargets.Contracts.csproj" />
      <ProjectReference Include="..\..\StorageProfiles\StorageProfiles.Contracts\StorageProfiles.Contracts.csproj" />
      <ProjectReference Include="..\..\ComputeProfiles\ComputeProfiles.Contracts\ComputeProfiles.Contracts.csproj" />
      <ProjectReference Include="..\..\ResourceDeployments\ResourceDeployments.Contracts\ResourceDeployments.Contracts.csproj" />
      <ProjectReference Include="..\..\ResourceDeployments\ResourceDeployments.Events\ResourceDeployments.Events.csproj" />
      <ProjectReference Include="..\..\ResourceGroups\ResourceGroups.Contracts\ResourceGroups.Contracts.csproj" />
      <ProjectReference Include="..\..\Secrets\Secrets.Contracts\Secrets.Contracts.csproj" />
      <ProjectReference Include="..\..\Search\Search.Contracts\Search.Contracts.csproj" />
      <ProjectReference Include="..\..\Quotas\Quotas.Contracts\Quotas.Contracts.csproj" />
      <ProjectReference Include="..\..\Quotas\Quotas.Primitives\Quotas.Primitives.csproj" />
      <ProjectReference Include="..\..\Outbox\Outbox.Contracts\Outbox.Contracts.csproj" />
      <ProjectReference Include="..\Postgres.Domain\Postgres.Domain.fsproj" />
      <ProjectReference Include="..\Postgres.Events\Postgres.Events.fsproj" />
      <ProjectReference Include="..\..\..\shared\helpers\ASP\ASP.csproj" />
      <ProjectReference Include="..\..\..\shared\Database\Database.csproj" />
      <ProjectReference Include="..\..\..\shared\Multitenancy\Multitenancy.csproj" />
      <ProjectReference Include="..\..\..\shared\Kubernetes\Kubernetes.csproj" />
      <ProjectReference Include="..\..\..\shared\Events\Events.csproj" />
      <ProjectReference Include="..\..\..\shared\Request\Request.csproj" />
      <ProjectReference Include="..\..\..\shared\Mediator\Mediator.csproj" />
      <ProjectReference Include="..\..\..\shared\Validation\Validation.csproj" />
      <ProjectReference Include="..\..\..\shared\Workloads\Workloads.csproj" />
    </ItemGroup>
</Project>
