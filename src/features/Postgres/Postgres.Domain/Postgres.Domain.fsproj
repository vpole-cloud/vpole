<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>Pole.Features.Postgres.Domain</AssemblyName>
        <RootNamespace>Pole.Features.Postgres.Domain</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core"/>
        <PackageReference Include="MongoDB.Driver"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="PostgresProvisioning.fs"/>
        <Compile Include="PostgresRecovery.fs"/>
        <Compile Include="PostgresCluster.fs"/>
        <Compile Include="PostgresManagedDatabase.fs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../../shared/Multitenancy.Primitives/Multitenancy.Primitives.csproj"/>
    </ItemGroup>
</Project>
