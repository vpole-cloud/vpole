<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>Pole.Features.Postgres.Events</AssemblyName>
        <RootNamespace>Pole.Features.Postgres.Events</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="PostgresClusterCreatedEvent.fs" />
        <Compile Include="PostgresClusterUpdatedEvent.fs" />
        <Compile Include="PostgresClusterDeletedEvent.fs" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\shared\Observability\Observability.csproj" />
      <ProjectReference Include="..\..\..\shared\Events\Events.csproj" />
      <ProjectReference Include="..\..\..\shared\Models\Models.csproj" />
      <ProjectReference Include="..\..\StorageProfiles\StorageProfiles.Contracts\StorageProfiles.Contracts.csproj" />
    </ItemGroup>

</Project>
