<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Pole.Features.Postgres.Migrations</AssemblyName>
    <RootNamespace>Pole.Features.Postgres.Migrations</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../shared/Migrations/Migrations.csproj" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="FSharp.Core" /></ItemGroup>
  <ItemGroup>
    <Compile Include="PostgresNameIndexesMigration.fs" />
  </ItemGroup>
</Project>
