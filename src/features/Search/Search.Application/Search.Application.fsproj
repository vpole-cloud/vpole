<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>Pole.Features.Search.Application</AssemblyName>
        <RootNamespace>Pole.Features.Search.Application</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Common\SearchDto.fs" />
        <Compile Include="Common\ISearchDbContext.fs" />
        <Compile Include="Migrations\SearchDocumentIndexesMigration.fs" />
        <Compile Include="Projection\SearchDocumentFactory.fs" />
        <Compile Include="Services\SearchService.fs" />
        <Compile Include="DependencyInjection.fs" />
        <Compile Include="Consumers\ResourceGroupConsumers.fs" />
        <Compile Include="Consumers\WebServiceConsumers.fs" />
        <Compile Include="Consumers\RedisConsumers.fs" />
        <Compile Include="Consumers\PostgresConsumers.fs" />
        <Compile Include="Endpoints\GetSearchResults.fs" />
        <Compile Include="Endpoints\AllSearchEndpoints.fs" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.1.1" />
        <PackageReference Update="FSharp.Core" Version="10.1.203" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\shared\helpers\ASP\ASP.csproj" />
      <ProjectReference Include="..\..\..\shared\Database\Database.csproj" />
      <ProjectReference Include="..\..\..\shared\Multitenancy\Multitenancy.csproj" />
      <ProjectReference Include="..\..\..\shared\Request\Request.csproj" />
      <ProjectReference Include="..\..\..\shared\Mediator\Mediator.csproj" />
      <ProjectReference Include="..\..\..\shared\ResultType\ResultType.csproj" />
      <ProjectReference Include="..\..\DnsRecords\DnsRecords.Events\DnsRecords.Events.csproj" />
      <ProjectReference Include="..\..\Postgres\Postgres.Events\Postgres.Events.fsproj" />
      <ProjectReference Include="..\..\RedisServices\RedisServices.Events\RedisServices.Events.csproj" />
      <ProjectReference Include="..\..\ResourceGroups\ResourceGroups.Events\ResourceGroups.Events.csproj" />
      <ProjectReference Include="..\..\WebServices\WebServices.Events\WebServices.Events.csproj" />
      <ProjectReference Include="..\Search.Domain\Search.Domain.fsproj" />
    </ItemGroup>
</Project>






