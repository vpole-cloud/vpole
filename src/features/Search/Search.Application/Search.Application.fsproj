<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AssemblyName>Pole.Features.Search.Application</AssemblyName>
        <RootNamespace>Pole.Features.Search.Application</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Common\SearchSourceTypeRegistry.fs" />
        <Compile Include="Common\SearchDto.fs" />
        <Compile Include="Projection\SearchDocumentFactory.fs" />
        <Compile Include="Mongo\SearchFilters.fs" />
        <Compile Include="Projection\SearchProjectionStore.fs" />
        <Compile Include="Projection\PersistSearchDocumentSet.fs" />
        <Compile Include="Projection\RemoveSearchDocumentSet.fs" />
        <Compile Include="Projection\PersistSearchOperationalStatus.fs" />
        <Compile Include="Queries\SearchIndexedDocuments.fs" />
        <Compile Include="Realtime\SearchRealtimeConsumer.fs" />
        <Compile Include="SearchPersistenceRegistration.fs" />
        <Compile Include="DependencyInjection.fs" />
        <Compile Include="Endpoints\GetSearchResults.fs" />
        <Compile Include="Endpoints\AllSearchEndpoints.fs" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\shared\helpers\ASP\ASP.csproj" />
      <ProjectReference Include="..\..\..\shared\Database\Database.csproj" />
      <ProjectReference Include="..\..\..\shared\Multitenancy\Multitenancy.csproj" />
      <ProjectReference Include="..\..\..\shared\Request\Request.csproj" />
      <ProjectReference Include="..\..\..\shared\Mediator\Mediator.csproj" />
      <ProjectReference Include="..\..\..\shared\ResultType\ResultType.csproj" />
      <ProjectReference Include="..\Search.Contracts\Search.Contracts.csproj" />
      <ProjectReference Include="..\Search.Events\Search.Events.csproj" />
      <ProjectReference Include="..\..\Outbox\Outbox.Contracts\Outbox.Contracts.csproj" />
      <ProjectReference Include="..\..\Realtime\Realtime.Contracts\Realtime.Contracts.csproj" />
      <ProjectReference Include="..\Search.Domain\Search.Domain.fsproj" />
    </ItemGroup>
</Project>
