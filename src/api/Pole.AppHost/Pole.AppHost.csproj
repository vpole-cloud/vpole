<Project Sdk="Aspire.AppHost.Sdk/13.1.0">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Pole.AppHost</AssemblyName>
        <RootNamespace>Pole.AppHost</RootNamespace>
        <UserSecretsId>04d1d0ff-2c15-4aee-8ad0-76dedf14aa09</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\examples\Blog\Blog.csproj" />
      <ProjectReference Include="..\Pole.Server\Pole.Server.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Aspire.Hosting.AppHost" Version="13.3.0" />
      <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.3.0" />
      <PackageReference Include="Aspire.Hosting.Keycloak" Version="13.1.0-preview.1.25616.3" />
      <PackageReference Include="Aspire.Hosting.MongoDB" Version="13.3.0" />
      <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.3.0" />
      <PackageReference Include="SharpCompress" Version="0.48.0" />
      <PackageReference Include="Snappier" Version="1.3.1" />
    </ItemGroup>

    <ItemGroup>
      <None Update="MongoDb\mongo-init.sh">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
