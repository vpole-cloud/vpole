{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Realtime": {
    "Enabled": false,
    "AllowedOrigins": ["http://localhost:5173"],
    "EnabledTopics": [],
    "SessionLifetime": "00:05:00"
  },
  "EnvelopeEncryption": {
    "ActiveProviderId": "local-key-file",
    "LocalKeyFile": {
      "ActiveKeyId": "pole-local",
      "ActiveKeyVersion": 1,
      "Keys": [
        {
          "Id": "pole-local",
          "Version": 1,
          "Path": "/run/pole-keys/envelope-kek-v1.b64"
        }
      ]
    }
  },
  "DeploymentTargets": {
    "ValidationTimeoutSeconds": 15,
    "Bootstrap": {
      "Enabled": true,
      "DisplayName": "Local cluster",
      "Mode": "Auto",
      "WorkloadConfiguration": {
        "Ingress": {
          "IngressClassName": "traefik",
          "ClusterIssuerName": "letsencrypt-prod",
          "PublicBaseDomain": "apps.localhost"
        }
      }
    }
  },
  "Outbox": {
    "ProcessingCronExpression": "* * * * *",
    "BatchSize": 100,
    "InitialRetryDelay": "00:00:15",
    "MaximumRetryDelay": "00:05:00",
    "PublishedRetentionDays": 7,
    "AbandonedRetentionDays": 30,
    "CleanupBatchSize": 500
  },
  "Postgres": {
    "DefaultDeploymentMode": "Operator",
    "SupportedVersions": {
      "From": 16,
      "To": 17
    },
    "OperatorImage": {
      "Server": "ghcr.io",
      "Name": "cloudnative-pg/postgresql"
    },
    "StatefulSetImage": {
      "Server": "docker.io",
      "Name": "postgres"
    }
  },
  "KeycloakAdmin": {
    "BaseUrl": "http://localhost:8080",
    "Realm": "pole.control-plane",
    "AdminClientId": "pole.control-plane.admin",
    "AdminClientSecret": "dev-admin-secret"
  },
  "Functions": {
    "Coordination": {
      "CallTimeoutSeconds": 5,
      "InitialAdmissionLeaseSeconds": 15,
      "AdmissionLeaseSeconds": 300,
      "RecoveryGraceSeconds": 300,
      "ActivationLeaseSeconds": 150,
      "ScaleTransitionLeaseSeconds": 300,
      "ScalerOwnershipLeaseSeconds": 10
    },
    "Orleans": {
      "ServiceId": "pole-functions",
      "ClusterId": "pole-functions",
      "DatabaseName": "pole-orleans",
      "CollectionPrefix": "Functions_",
      "UseKubernetesHosting": true,
      "SiloPort": 11111,
      "GatewayPort": 0,
      "ResponseTimeoutSeconds": 10
    }
  },
  "kubernetes": {
    "NamespaceNamePrefix": "prod-pole"
  }
}
