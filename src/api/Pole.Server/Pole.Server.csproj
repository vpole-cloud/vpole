<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Keycloak.Authentication" Version="13.1.0-preview.1.25616.3" />
        <PackageReference Include="Aspire.MongoDB.Driver" Version="13.3.0" />
        <PackageReference Include="Aspire.RabbitMQ.Client" Version="13.3.0" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
        <PackageReference Include="Hangfire" Version="1.8.23" />
        <PackageReference Include="Hangfire.Mongo" Version="1.15.0" />
        <PackageReference Include="MassTransit.RabbitMQ" Version="9.1.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\features\DnsRecords\Core\Core.csproj" />
      <ProjectReference Include="..\..\shared\Events\Events.csproj" />
      <ProjectReference Include="..\..\features\Outbox\Core\Core.csproj" />
      <ProjectReference Include="..\..\features\Postgres\Core\Core.fsproj" />
      <ProjectReference Include="..\..\features\RedisServices\Core\Core.csproj" />
      <ProjectReference Include="..\..\features\ResourceGroups\Core\Core.csproj" />
      <ProjectReference Include="..\..\features\Search\Core\Core.fsproj" />
      <ProjectReference Include="..\..\features\WebServices\Core\Core.csproj" />
      <ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
    </ItemGroup>

</Project>
