<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Keycloak.Authentication" Version="13.1.0-preview.1.25616.3" />
        <PackageReference Include="Aspire.MongoDB.Driver" Version="13.3.0" />
        <PackageReference Include="Aspire.RabbitMQ.Client" Version="13.3.0" />
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
        <PackageReference Include="Hangfire" Version="1.8.23" />
        <PackageReference Include="Hangfire.Mongo" Version="1.15.0" />
        <PackageReference Include="MassTransit.RabbitMQ" Version="9.1.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Pole.Feature.DomainNames\Pole.Feature.DomainNames.csproj" />
      <ProjectReference Include="..\Pole.Features.Events\Pole.Features.Events.csproj" />
      <ProjectReference Include="..\Pole.Features.Outbox\Pole.Features.Outbox.csproj" />
      <ProjectReference Include="..\Pole.Features.Postgres\Pole.Features.Postgres.fsproj" />
      <ProjectReference Include="..\Pole.Features.RedisServices\Pole.Features.RedisServices.csproj" />
      <ProjectReference Include="..\Pole.Features.ResourceGroups\Pole.Features.ResourceGroups.csproj" />
      <ProjectReference Include="..\Pole.Features.Search\Pole.Features.Search.fsproj" />
      <ProjectReference Include="..\Pole.Features.WebServices\Pole.Features.WebServices.csproj" />
      <ProjectReference Include="..\Pole.ServiceDefaults\Pole.ServiceDefaults.csproj" />
    </ItemGroup>

</Project>
