{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Outbox": {
    "ProcessingCronExpression": "*/15 * * * * *",
    "RetentionDays": 7,
    "MaxRetryAttempts": 5
  },
  "DnsRecord": {
    "DefaultReservationMinutes": 60
  },
  "kubernetes": {
    "NamespaceNamePrefix": "prod-pole"
  }
}
