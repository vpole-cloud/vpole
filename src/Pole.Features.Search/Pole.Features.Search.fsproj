      <ProjectReference Include="..\Pole.Feature.DomainNames\Pole.Feature.DomainNames.csproj" />
      <ProjectReference Include="..\Pole.Features.Postgres\Pole.Features.Postgres.fsproj" />
      <ProjectReference Include="..\Pole.Features.Request\Pole.Features.Request.csproj" />
      <ProjectReference Include="..\Pole.Features.RedisServices\Pole.Features.RedisServices.csproj" />
      <ProjectReference Include="..\Pole.Features.ResourceGroups\Pole.Features.ResourceGroups.csproj" />
      <ProjectReference Include="..\Pole.Features.WebServices\Pole.Features.WebServices.csproj" />
      <ProjectReference Include="..\Pole.Mediator\Pole.Mediator.csproj" />
      <ProjectReference Include="..\Pole.ResultType\Pole.ResultType.csproj" />
