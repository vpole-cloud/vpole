        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
        <PackageReference Include="Hangfire" Version="1.8.22" />
        <PackageReference Include="Hangfire.Mongo" Version="1.12.2" />
        <PackageReference Include="KubernetesClient" Version="18.0.13" />
        <PackageReference Include="MassTransit.RabbitMQ" Version="9.0.0-develop.31" />
        <PackageReference Include="MongoDB.Driver" Version="3.5.2" />
