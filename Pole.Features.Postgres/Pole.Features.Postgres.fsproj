<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Common\PostgresClusterDto.fs" />
        <Compile Include="Common\MongoExtensions.fs" />
        <Compile Include="Common\ResultF.fs" />
        <Compile Include="Events\CreateEvent.fs" />
        <Compile Include="Events\DeleteEvent.fs" />
        <Compile Include="Events\UpdateEvent.fs" />
        <Compile Include="Endpoints\Create.fs" />
        <Compile Include="Endpoints\Delete.fs" />
        <Compile Include="Endpoints\Update.fs" />
        <Compile Include="Endpoints\GetById.fs" />
        <Compile Include="Endpoints\Get.fs" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="MassTransit.Abstractions" Version="8.5.7" />
        <PackageReference Include="FluentValidation" Version="12.1.1" />
        <PackageReference Include="KubernetesClient" Version="18.0.13" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Pole.Database\Pole.Database.csproj" />
      <ProjectReference Include="..\Pole.Features\Pole.Features.csproj" />
      <ProjectReference Include="..\Pole.Mediator\Pole.Mediator.csproj" />
    </ItemGroup>
</Project>
